# The code reads these variables from the process environment (on Windows, also from the user
# environment in the registry). It does not load this file by itself.

# OpenRouter: the verifier of levels 2 and 3 and the three judges of the evaluation.
OPENROUTER_API_KEY=

# OpenAlex: sent as a bearer token when set. Recommended for level 3 and for the evaluation.
OPENALEX_API_KEY=

# Brave Search: web search tool of the level 2 verifier. When empty, the code reads
# mcpServers.brave-search.env.BRAVE_API_KEY from ~/.claude.json.
BRAVE_API_KEY=
